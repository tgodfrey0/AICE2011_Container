# ---------------------------------------------------------------------------
# AICE2011 container lab -- per-machine settings.
#
# This is the only file you need to edit. Change the values below, then run:
#
#     docker compose up -d
#
# docker compose reads this file automatically, so no extra flags are needed.
# ---------------------------------------------------------------------------

# Where your ROS 2 workspace lives on THIS machine.
#
# This is a path on your computer, not inside the container. Everything you
# create in the lab appears here and survives "docker compose down".
#
# Use forward slashes, and keep the trailing slash off. Docker Desktop creates
# the folder for you if it does not exist yet.
#
#   University H: drive (network filestore)
#     ROS2_WS=H:/aice2011/ros2_ws
#
#   Windows, local disk
#     ROS2_WS=C:/Users/yourname/aice2011_container/ros2_ws
#
#   Linux
#     ROS2_WS=/home/yourname/aice2011_container/ros2_ws
#
#   macOS
#     ROS2_WS=/Users/yourname/aice2011_container/ros2_ws
#
# The default assumes this folder is sitting next to this .env file.
ROS2_WS=./ros2_ws

# Host port for the lab's web desktop.
#
# Change the left-hand number if something else on your machine already uses
# 6080. If you do, the browser address in the README changes to match:
#     http://127.0.0.1:<this number>/vnc.html?autoconnect=true
VNC_PORT=6080