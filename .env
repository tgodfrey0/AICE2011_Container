# ---------------------------------------------------------------------------
# AICE2011 container lab -- per-machine settings.
#
# This is the only file you need to edit. Change the values below, then run:
#
#     docker compose up -d
#
# docker compose reads this file automatically, so no extra flags are needed.
# ---------------------------------------------------------------------------

# Where your ROS 2 workspace lives.
# Docker Desktop creates the folder for you if it does not exist yet.
# ROS2_WS="C:/Users/[USERNAME]/OneDrive - University of Southampton/Desktop/ros2_ws"
ROS2_WS="./ros2_ws"

# Host port for the web desktop.
# http://127.0.0.1:[VNC_PORT]/vnc.html?autoconnect=true
VNC_PORT=6080
